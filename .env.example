# Copy to `.env` (gitignored) and fill in. The CLI loads it at startup; an already
# exported variable always wins, so CI and a shell export stay authoritative.

# Required for real runs (`--cassette-mode off|record`). Not needed for `replay`.
ANTHROPIC_API_KEY=

# Optional: raises the GitHub API rate limit for `github_evidence`. Works without it.
GITHUB_TOKEN=
